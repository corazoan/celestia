model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  products  Product[]
  parentId  Int?
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}
